---
import type { ResumeItem } from "../types/config";

type Props = ResumeItem;
const { title, company, date, summary } = Astro.props;
---

<article class="grid gap-3 border-t border-[#cdccc3] py-6 sm:grid-cols-[1fr_180px] sm:gap-8">
  <div>
    <h3 class="font-semibold">{title}</h3>
    <a href={company.url} target="_blank" rel="noreferrer" class="mt-1 inline-block text-sm text-[#65665f] hover:text-[#d94f32]">
      {company.name} ↗
    </a>
    {summary && <p class="mt-4 max-w-xl text-sm leading-6 text-[#65665f]">{summary}</p>}
  </div>
  <p class="meta sm:text-right">{date}</p>
</article>
