---
import { Image } from "astro:assets";

import type { ResumeItem } from "../types/config";

type Props = ResumeItem;

const { title, company, date, summary } = Astro.props;

const { image, name, url } = company;
---

<a
  href={url}
  class="interactive-surface flex items-center justify-between gap-4 rounded-2xl p-4 group-hover:opacity-60 hover:!opacity-100"
>
  <div class="flex items-center gap-4">
    <Image
      src={image}
      alt={name}
      width={40}
      height={40}
      class="h-11 w-11 rounded-full object-cover ring-1 ring-white/15"
    />
    <div>
      <h3 class="font-medium">{title}</h3>
      <p class="muted text-sm">{name}</p>
      {summary && <p class="muted mt-2 max-w-md text-sm leading-6">{summary}</p>}
    </div>
  </div>
  <p class="muted shrink-0 text-right text-sm">{date}</p>
</a>
