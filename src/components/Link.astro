---
import { Icon } from "astro-icon/components";

interface Props {
  text: string;
  href: string;
  external?: boolean;
  noAnchor?: boolean;
}

const { external, href, noAnchor, text } = Astro.props;
---

{
  noAnchor && (
    <div class="inline-flex items-center gap-2 text-sm font-medium text-white/62 transition-colors group-hover:text-white/35 hover:!text-white">
      <div class="rotate-45">
        <Icon name="mdi:arrow-up" />
      </div>
      <span>{text}</span>
    </div>
  )
}
{
  !noAnchor && (
    <a
      href={href}
      target={external ? "_blank" : "_self"}
      class="inline-flex items-center gap-2 text-sm font-medium text-white/62 transition-colors group-hover:text-white/35 hover:!text-white"
    >
      <div class="rotate-45">
        <Icon name="mdi:arrow-up" />
      </div>
      <span>{text}</span>
    </a>
  )
}
