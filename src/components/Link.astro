---
interface Props {
  text: string;
  href: string;
  external?: boolean;
  noAnchor?: boolean;
}

const { external, href, noAnchor, text } = Astro.props;
const classes = "text-link";
---

{
  noAnchor ? (
    <span class={classes}>{text}<span aria-hidden="true">{external ? "↗" : "→"}</span></span>
  ) : (
    <a href={href} target={external ? "_blank" : "_self"} rel={external ? "noreferrer" : undefined} class={classes}>
      {text}<span aria-hidden="true">{external ? "↗" : "→"}</span>
    </a>
  )
}
