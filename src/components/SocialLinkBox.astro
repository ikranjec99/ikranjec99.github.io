---
import { Icon } from "astro-icon/components";
import type { SocialLink } from "../types/config";

type Props = SocialLink;
const { title, url, icon, external } = Astro.props;
---

<a
  href={url}
  class="index-row flex items-center justify-between gap-4 py-5 hover:text-[#d94f32]"
  target={external ? "_blank" : "_self"}
  rel={external ? "noreferrer" : undefined}
>
  <span class="flex items-center gap-3 font-semibold">
    <Icon name={icon} width={19} height={19} />
    {title}
  </span>
  <span aria-hidden="true">{external ? "↗" : "→"}</span>
</a>
