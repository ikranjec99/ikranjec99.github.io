---
import { Image } from "astro:assets";
import FadeInText from "@astroanimate/core/FadeInText";
import ScaleIn from "@astroanimate/core/ScaleIn";

import { homePageContent, identity } from '../config';
import SocialLink from "../components/SocialLink.astro";
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout seo={homePageContent.seo}>
  <section class="page-shell page-section">
    <FadeInText duration={0.7} yOffset={24}>
      <span class="eyebrow">Personal Blog</span>
      <h1 class="page-title text-balance">{identity.name}</h1>
      <p class="mt-5 text-xl font-medium text-white/78">{homePageContent.role}</p>
    </FadeInText>

    <ScaleIn class="surface mt-10 rounded-2xl p-5 sm:p-6" duration={520} delay={120}>
      <div class="flex flex-col gap-6 min-[560px]:flex-row min-[560px]:items-center">
        <Image
          src={identity.logo}
          alt={identity.name}
          width={132}
          height={132}
          class="h-28 w-28 rounded-2xl object-cover ring-1 ring-white/15 sm:h-32 sm:w-32"
        />
        <div class="min-w-0">
          <p class="lede text-pretty">
            {homePageContent.description}
          </p>
          <div class="group mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
            {
              homePageContent.links.map((link) => (
                <Link text={link.title} href={link.url} external={link.external} />
              ))
            }
          </div>
        </div>
      </div>
    </ScaleIn>

    <FadeInText class="group mt-7 flex flex-wrap gap-4" duration={0.6} delay={0.12}>
      {
        homePageContent.socialLinks.map((link) => (
          <SocialLink
            title={link.title}
            url={link.url}
            icon={link.icon}
            external={link.external}
          />
        ))
      }
    </FadeInText>
  </section>

  <section class="page-shell mt-24">
    <FadeInText duration={0.6} enhance>
      <h2 class="section-title mb-8">Working Principles</h2>
    </FadeInText>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        homePageContent.focusAreas.map((area, index) => (
          <FadeInText duration={0.55} delay={index * 0.08} enhance>
            <div class="interactive-surface h-full rounded-2xl p-4">
              <h3 class="font-semibold">{area.title}</h3>
              <p class="muted mt-3 text-sm leading-6">{area.description}</p>
            </div>
          </FadeInText>
        ))
      }
    </div>
  </section>

  <section class="page-shell mt-24">
    <FadeInText duration={0.6} enhance>
      <h2 class="section-title mb-8">Currently Exploring</h2>
    </FadeInText>
    <div class="grid gap-4">
      {
        homePageContent.currently.map((item, index) => (
          <FadeInText duration={0.55} delay={index * 0.08} enhance>
            <div class="interactive-surface rounded-2xl p-4 sm:grid sm:grid-cols-[220px_1fr] sm:gap-6">
              <h3 class="font-semibold">{item.title}</h3>
              <p class="muted mt-3 text-sm leading-6 sm:mt-0">{item.description}</p>
            </div>
          </FadeInText>
        ))
      }
    </div>
  </section>

  <section class="page-shell mt-24">
    <FadeInText duration={0.6} enhance>
      <h2 class="section-title mb-8">Work Index</h2>
    </FadeInText>
    <div class="grid gap-4 sm:grid-cols-2">
      <FadeInText duration={0.55} enhance>
        <a href="/work#selected-projects" class="interactive-surface block h-full rounded-2xl p-5">
          <h3 class="text-xl font-semibold">Selected Projects</h3>
          <p class="muted mt-3 text-sm leading-6">
            Projects paired with notes on the technical decisions behind them.
          </p>
        </a>
      </FadeInText>
      <FadeInText duration={0.55} delay={0.08} enhance>
        <a href="/blog" class="interactive-surface block h-full rounded-2xl p-5">
          <h3 class="text-xl font-semibold">Writing</h3>
          <p class="muted mt-3 text-sm leading-6">
            The full archive of technical notes, project writeups, and lessons learned.
          </p>
        </a>
      </FadeInText>
    </div>
  </section>
</Layout>
