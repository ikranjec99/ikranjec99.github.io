---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import { homePageContent, identity, projectsPageContent } from "../config";
import Layout from "../layouts/Layout.astro";
import { formatPostDate } from "../utils/date";

const posts = await getCollection("posts");
posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const recentPosts = posts.slice(0, 3);
const selectedProjects = projectsPageContent.projects.slice(0, 3);
---

<Layout seo={homePageContent.seo}>
  <section class="page-shell page-intro">
    <div class="grid gap-12 lg:grid-cols-[1fr_220px] lg:items-end">
      <div>
        <p class="kicker">Software engineer · Croatia</p>
        <h1 class="display-title mt-5 text-balance">{identity.name}</h1>
        <p class="mt-7 max-w-2xl text-balance text-xl font-medium leading-snug sm:text-2xl">
          {homePageContent.role}
        </p>
        <p class="lede mt-5 text-pretty">{homePageContent.description}</p>
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
          {
            homePageContent.links.map((link) => (
              <a class="text-link" href={link.url} target={link.external ? "_blank" : "_self"}>
                {link.title}<span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>

      <Image
        src={identity.logo}
        alt={identity.name}
        width={440}
        height={440}
        class="aspect-square w-40 border border-[#cdccc3] object-cover grayscale lg:w-full"
      />
    </div>
  </section>

  <section class="page-shell mt-28">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
      <div>
        <div class="mb-7 flex items-baseline justify-between gap-4">
          <h2 class="section-label">Selected work</h2>
          <a href="/work" class="text-xs font-semibold text-[#65665f] hover:text-[#d94f32]">All work →</a>
        </div>
        <ol>
          {
            selectedProjects.map((project, index) => (
              <li class="index-row">
                <a href={project.url} target="_blank" rel="noreferrer" class="grid grid-cols-[2rem_1fr_auto] gap-3 py-5">
                  <span class="meta pt-1">{String(index + 1).padStart(2, "0")}</span>
                  <span>
                    <span class="row-title block font-semibold">{project.title}</span>
                    <span class="mt-1.5 block text-sm leading-6 text-[#65665f]">{project.description}</span>
                  </span>
                  <span aria-hidden="true" class="pt-0.5 text-[#65665f]">↗</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <div class="mb-7 flex items-baseline justify-between gap-4">
          <h2 class="section-label">Recent notes</h2>
          <a href="/blog" class="text-xs font-semibold text-[#65665f] hover:text-[#d94f32]">All writing →</a>
        </div>
        <ol>
          {
            recentPosts.map((post) => (
              <li class="index-row">
                <a href={`/blog/${post.id}`} class="block py-5">
                  <span class="meta">{formatPostDate(post.data.pubDate)}</span>
                  <span class="row-title mt-2 block font-semibold leading-snug">{post.data.title}</span>
                  <span class="mt-1.5 block text-sm leading-6 text-[#65665f]">{post.data.description}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</Layout>
