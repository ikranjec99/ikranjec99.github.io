---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import { blogPageContent } from "../../config";
import { formatPostDate } from "../../utils/date";

const posts = await getCollection("posts");
posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const postsWithReadingTime = await Promise.all(
  posts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return { post, readingTime: remarkPluginFrontmatter.minutesRead };
  }),
);
---

<Layout seo={blogPageContent.seo}>
  <section class="page-shell page-intro">
    <p class="kicker">Writing</p>
    <h1 class="page-title mt-5">Notes from the workbench.</h1>
    <p class="lede mt-7">{blogPageContent.subtitle}</p>
  </section>

  <section class="page-shell mt-24">
    <ol class="border-b border-[#cdccc3]">
      {
        postsWithReadingTime.map(({ post, readingTime }, index) => (
          <li class="index-row">
            <a
              href={`/blog/${post.id}`}
              class="grid gap-5 py-7 sm:grid-cols-[3rem_1fr_150px] sm:items-center sm:py-8"
            >
              <span class="meta self-start pt-1">{String(index + 1).padStart(2, "0")}</span>
              <span>
                <span class="meta">{formatPostDate(post.data.pubDate)} · {readingTime}</span>
                <span class="row-title mt-2 block text-xl font-semibold tracking-[-0.025em] sm:text-2xl">
                  {post.data.title}
                </span>
                <span class="mt-3 block max-w-2xl text-sm leading-6 text-[#65665f]">
                  {post.data.description}
                </span>
                {
                  post.data.tags && (
                    <span class="meta mt-4 block">{post.data.tags.join(" · ")}</span>
                  )
                }
              </span>
              <Image
                src={post.data.image.url}
                alt=""
                width={300}
                height={200}
                class="aspect-[3/2] w-full border border-[#cdccc3] object-cover"
              />
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
