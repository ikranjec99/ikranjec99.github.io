---
import ResumeItem from "../components/ResumeItem.astro";
import SocialLinkBox from "../components/SocialLinkBox.astro";
import Layout from "../layouts/Layout.astro";
import { aboutPageContent } from "../config/about";
---

<Layout seo={aboutPageContent.seo}>
  <section class="page-shell page-intro">
    <p class="kicker">About</p>
    <div class="mt-5 grid gap-10 md:grid-cols-[1fr_180px] md:items-start">
      <div>
        <h1 class="page-title">A practical engineer with a product mindset.</h1>
        <p class="lede mt-7">{aboutPageContent.subtitle}</p>
        <div class="mt-8 max-w-2xl text-base leading-8 text-[#42433d]">
          <Fragment set:html={aboutPageContent.about.description} />
        </div>
      </div>
      <img
        src="/profile-picture.webp"
        alt="Ivan Kranjec"
        width="360"
        height="360"
        loading="eager"
        class="aspect-square w-36 border border-[#cdccc3] object-cover grayscale md:w-full"
      />
    </div>
  </section>

  <section class="page-shell mt-28 grid gap-8 md:grid-cols-[180px_1fr]">
    <div>
      <h2 class="section-label">Experience</h2>
      <p class="mt-4 max-w-[16rem] text-sm leading-6 text-[#65665f]">
        Product work across the stack, from customer-facing flows to background systems and internal tooling.
      </p>
    </div>
    <div class="border-b border-[#cdccc3]">
      {
        aboutPageContent.work.items.map((item) => (
          <ResumeItem
            company={item.company}
            date={item.date}
            summary={item.summary}
            title={item.title}
          />
        ))
      }
    </div>
  </section>

  <section class="page-shell mt-28 grid gap-8 md:grid-cols-[180px_1fr]">
    <div>
      <h2 class="section-label">Elsewhere</h2>
      <p class="mt-4 text-sm leading-6 text-[#65665f]">{aboutPageContent.connect.description}</p>
    </div>
    <div class="border-b border-[#cdccc3]">
      {
        aboutPageContent.connect.links.map((item) => (
          <SocialLinkBox
            title={item.title}
            url={item.url}
            icon={item.icon}
            external={item.external}
          />
        ))
      }
    </div>
  </section>
</Layout>
