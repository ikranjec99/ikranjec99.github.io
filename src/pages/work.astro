---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import Layout from "../layouts/Layout.astro";
import { projectsPageContent } from "../config";

const posts = await getCollection("posts");
const postsWithReadingTime = await Promise.all(
  posts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return { post, readingTime: remarkPluginFrontmatter.minutesRead };
  }),
);

const postsById = new Map(postsWithReadingTime.map((item) => [item.post.id, item]));
const projectsByTitle = new Map(
  projectsPageContent.projects.map((project) => [project.title, project]),
);

const pairings = [
  ["Echo", "echo-browser-request-interceptor", "Browser tooling · local-first architecture · Manifest V3"],
  ["OBDeleven Log Parser", "obdeleven-log-parser", "Developer tooling · parsing · data modeling"],
  ["QR Code Generator API", "qr-code-generator", "API design · configuration · practical automation"],
  ["LLaMA .NET Chat Client", "llama-core", ".NET abstractions · local tooling · replaceable dependencies"],
] as const;

const featuredCaseStudies = pairings.flatMap(([projectTitle, postId, focus]) => {
  const project = projectsByTitle.get(projectTitle);
  const note = postsById.get(postId);
  return project && note ? [{ project, note, focus }] : [];
});
---

<Layout seo={projectsPageContent.seo}>
  <section class="page-shell page-intro">
    <p class="kicker">Selected work</p>
    <h1 class="page-title mt-5">Things I’ve built and learned from.</h1>
    <p class="lede mt-7">
      A short index of projects with the problem, approach, and technical note behind each one.
    </p>
  </section>

  <section id="selected-projects" class="page-shell mt-24 scroll-mt-24">
    <ol class="border-b border-[#cdccc3]">
      {
        featuredCaseStudies.map(({ project, note, focus }, index) => (
          <li class="index-row py-8 sm:py-10">
            <article class="grid gap-6 sm:grid-cols-[3rem_1fr] lg:grid-cols-[3rem_1fr_260px] lg:gap-8">
              <p class="meta pt-1">{String(index + 1).padStart(2, "0")}</p>
              <div>
                <p class="meta">{project.year} · {focus}</p>
                <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] sm:text-3xl">
                  <a class="row-title" href={`/blog/${note.post.id}`}>{project.title}</a>
                </h2>
                <p class="mt-4 max-w-xl leading-7 text-[#65665f]">{project.description}</p>
                <p class="mt-5 text-sm leading-6 text-[#42433d]">
                  <span class="font-semibold text-[#191a17]">Built with</span> {project.stack.join(" · ")}
                </p>
                <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3">
                  <a class="text-link" href={`/blog/${note.post.id}`}>
                    Read the note · {note.readingTime}<span aria-hidden="true">→</span>
                  </a>
                  <a class="text-link" href={project.url} target="_blank" rel="noreferrer">
                    View source<span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
              <Image
                src={project.image}
                alt=""
                width={520}
                height={360}
                class="aspect-[4/3] w-full border border-[#cdccc3] object-cover sm:col-start-2 lg:col-start-3 lg:row-start-1"
              />
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
