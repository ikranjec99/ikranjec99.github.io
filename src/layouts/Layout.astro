---
import { navBarLinks, identity } from "../config";
import "../styles/global.css";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();

const isActive = (url: string) =>
  url === "/" ? currentPath === "/" : currentPath.startsWith(url);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3f1ea" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-[#cdccc3] bg-[#f3f1ea]/95 backdrop-blur-sm">
      <div class="page-shell flex h-16 items-center justify-between">
        <a href="/" class="text-sm font-bold tracking-[-0.02em]" aria-label={`${identity.name}, home`}>
          IK<span class="text-[#d94f32]">.</span>
        </a>

        <nav class="hidden sm:block" aria-label="Main navigation">
          <ul class="flex items-center gap-7">
            {
              navBarLinks.map((link) => (
                <li>
                  <a
                    class:list={[
                      "border-b pb-1 text-sm font-medium transition-colors hover:border-[#d94f32] hover:text-[#d94f32]",
                      isActive(link.url)
                        ? "border-[#191a17] text-[#191a17]"
                        : "border-transparent text-[#65665f]",
                    ]}
                    href={link.url}
                    target={link.external ? "_blank" : "_self"}
                    rel={link.external ? "noreferrer" : undefined}
                    aria-current={isActive(link.url) ? "page" : undefined}
                  >
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <details class="relative sm:hidden">
          <summary class="cursor-pointer list-none text-sm font-semibold marker:hidden">Menu</summary>
          <nav class="absolute right-0 top-9 w-40 border border-[#cdccc3] bg-[#faf9f5] p-2" aria-label="Mobile navigation">
            <ul>
              {
                navBarLinks.map((link) => (
                  <li>
                    <a
                      class:list={[
                        "block px-3 py-2.5 text-sm",
                        isActive(link.url) ? "font-semibold text-[#191a17]" : "text-[#65665f]",
                      ]}
                      href={link.url}
                      target={link.external ? "_blank" : "_self"}
                      rel={link.external ? "noreferrer" : undefined}
                      aria-current={isActive(link.url) ? "page" : undefined}
                    >
                      {link.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="page-shell mt-28 pb-8 pt-10">
      <div class="flex flex-col gap-3 border-t border-[#cdccc3] pt-5 text-xs text-[#65665f] sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {identity.name}</p>
        <p>Software, notes, and the thinking between them.</p>
      </div>
    </footer>
  </body>
</html>
